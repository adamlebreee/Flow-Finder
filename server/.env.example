PORT=3000
# Local:
# MONGODB_URI=mongodb://localhost:27017/Yoga
# Atlas (include DB name before ?, URL-encode password if it has special chars):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/Yoga?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/Yoga
# Comma-separated origins, e.g. http://localhost:8081,https://yourdomain.com
CORS_ORIGIN=
JWT_SECRET=replace-with-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
